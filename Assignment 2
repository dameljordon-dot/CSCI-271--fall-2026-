#include <iostream>
#include <string>
using namespace std;

int main() {
    string name;
    int age;

    cout << "Enter your name: ";
    getline(cin, name);

    cout << "Enter your age: ";
    cin >> age;

    cout << "Hello, I am " << name << "!" << endl;
    cout << "I am " << age << " years old." << endl;

    return 0;
}
