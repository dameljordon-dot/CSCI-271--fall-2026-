// File: menu_validate.cpp
// This program asks for a menu choice until the user enters 1, 2, or 3.

#include <iostream>
using namespace std;

int main()
{
    int choice; // Declare an integer variable to store the user's choice

    do // A do-while loop runs at least one time
    {
        cout << "Enter a menu choice (1, 2, or 3): "; // Ask the user to enter a menu choice
        cin >> choice; // Store the user's input

        if (choice != 1 && choice != 2 && choice != 3) // Check if the choice is NOT 1, 2, or 3
        {
            cout << "Invalid choice, try again." << endl; // Display an error message for an invalid choice
        }

    } while (choice != 1 && choice != 2 && choice != 3); // Repeat the loop while the choice is invalid

    cout << "You selected option " << choice << "." << endl; // Display the valid option selected by the user

    return 0; // End the program successfully
}
