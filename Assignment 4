// This program prints a multiplication table from 1 through 10.

#include <iostream>  // Allows us to use cout and cin
using namespace std; // Allows us to write cout and cin without std::

int main()
{
    int number; // Declare an integer variable to store the user's number

    cout << "Enter a number: "; // Ask the user to enter a whole number
    cin >> number; // Store the user's input in the variable number

    for (int i = 1; i <= 10; i++) // Loop from 1 through 10
    {
        cout << number << " x " << i << " = " // Multiply the user's number by i and display the result
             << number * i << endl;
    }

    return 0; // End the program successfully
} 

