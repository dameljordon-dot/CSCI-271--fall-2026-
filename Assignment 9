// Question 36: Swap Ends
// Use pointers to swap the first and last elements of an array.

#include <iostream>
using namespace std;

void swapValues(int* a, int* b) {
    int temp = *a; // Save the value stored at the first address.
    *a = *b; // Copy the second value into the first variable.
    *b = temp; // Copy the saved value into the second variable.
}

int main() {
    const int SIZE = 5;
    int scores[SIZE] = {85, 90, 78, 92, 88};

    // Pass the addresses of the first and last array elements.
    swapValues(&scores[0], &scores[SIZE - 1]);

    for (int i = 0; i < SIZE; i++) {
        cout << scores[i]; // Print the current array element.

        if (i < SIZE - 1) {
            cout << " "; // Put a space between the numbers.
        }
    }

    cout << endl;
    return 0;
}
