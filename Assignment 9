// Question 35: Sum of a File
// Place numbers.txt in the program's working directory.

#include <iostream> // Allows console output and error messages.
#include <fstream>  // Allows reading from a file.
using namespace std;

int main() {
    ifstream inFile("numbers.txt"); // Open the file for reading.

    if (!inFile.is_open()) { // Stop if the file could not be opened.
        cerr << "Error: Could not open numbers.txt." << endl;
        return 1;
    }

    int number; // Stores each whole number read from the file.
    long long sum = 0; // Stores the running total.

    while (inFile >> number) { // Read and add each number.
        sum += number;
    }

    inFile.close(); // Close the input file.

    cout << "Sum: " << sum << endl; // Display the total.
    return 0;
} 

